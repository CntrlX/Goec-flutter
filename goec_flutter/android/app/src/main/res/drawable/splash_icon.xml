<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ splash icons are masked to a circle.
  Safe zone is the center ~2/3 (192dp of 288dp). Extra inset keeps the logo
  from being clipped on the edges.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/splash_logo"
    android:insetLeft="22%"
    android:insetTop="22%"
    android:insetRight="22%"
    android:insetBottom="22%" />
